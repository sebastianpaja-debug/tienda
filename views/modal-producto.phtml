<!-- ===================== MODAL PRODUCTO ===================== -->

<div class="modal-overlay" id="modal-overlay" onclick="cerrarModal()"></div>

<div class="modal" id="modal-producto">

  <button class="modal-cerrar" onclick="cerrarModal()">&#10005;</button>

  <div class="modal-contenido">

    <div class="modal-imagen">
      <img id="modal-img" src="" alt="" />
    </div>

    <div class="modal-info">

      <p class="modal-categoria" id="modal-categoria"></p>
      <h2 class="modal-nombre" id="modal-nombre"></h2>
      <p class="modal-descripcion" id="modal-descripcion"></p>
      <p class="modal-precio" id="modal-precio"></p>

      <div class="modal-seccion" id="seccion-tallas">
        <p class="modal-label">Talla:</p>
        <div class="modal-tallas" id="modal-tallas"></div>
      </div>

      <div class="modal-seccion">
        <p class="modal-label">Color:</p>
        <div class="modal-colores" id="modal-colores"></div>
      </div>

      <div class="modal-seccion">
        <p class="modal-label">Cantidad:</p>
        <div class="modal-cantidad">
          <button onclick="cambiarCantidad(-1)">−</button>
          <span id="modal-cantidad-valor">1</span>
          <button onclick="cambiarCantidad(1)">+</button>
        </div>
      </div>

      <button class="btn-modal-agregar" id="btn-modal-agregar"
              onclick="agregarDesdeModal()">
        Agregar al Carrito
      </button>

    </div>
  </div>
</div>
